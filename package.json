{
  "name": "motion-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion Inspector — understand how any video moves. DevTools for video motion and editing.",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && vite build && vite build --config vite.content.config.ts && node scripts/build-manifest.mjs",
    "dev": "npm run icons && vite build --mode development --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "clean": "rm -rf dist public/icons"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.5",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
